# Address of the FastAPI backend (rrm-backend).
NEXT_PUBLIC_API_URL=http://localhost:8000
# Only accounts from this domain can sign in (same as the backend's ALLOWED_EMAIL_DOMAIN).
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN=student.usv.ro
# OAuth Client ID (Google Cloud → Credentials → Web application, origin http://localhost:3000).
# Same value as the backend's GOOGLE_CLIENT_ID. Empty = demo account chooser (POST /auth/demo).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
